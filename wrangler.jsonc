// Cloudflare Workers（静的アセットのみ）の設定ファイル。
// public/ 以下をそのまま配信する。Worker のスクリプトは持たない。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Workers 上のプロジェクト名（<name>.<account>.workers.dev で確認できる）
  "name": "shikumi-zukuri",
  "compatibility_date": "2026-01-01",
  "assets": {
    // 配信するディレクトリ
    "directory": "./public",
    // 存在しないパスは 404 を返す（1枚ものの LP なので SPA フォールバックはしない）
    "not_found_handling": "404-page"
  }
  // 独自ドメインは、shikumi-zukuri.com の DNS を Cloudflare に移した後に
  // 以下を追加して有効化する。
  // "routes": [
  //   { "pattern": "shikumi-zukuri.com", "custom_domain": true },
  //   { "pattern": "www.shikumi-zukuri.com", "custom_domain": true }
  // ]
}
